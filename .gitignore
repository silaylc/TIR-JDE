# Veri ve çıktılar (Git'e eklenmez)
data/*
!data/splits/
!data/splits/**
!data/raw/
data/raw/*
!data/raw/.gitkeep
!data/interim/
data/interim/*
!data/interim/.gitkeep
!data/processed/
data/processed/*
!data/processed/.gitkeep
!data/external/
data/external/*
!data/external/.gitkeep
runs/
outputs/
results/

# Model ağırlıkları (klasör izlenir, dosyalar izlenmez)
models/*
!models/.gitkeep
*.pt
*.pth
*.onnx
*.engine
weights/

# Üretilen rapor görselleri
reports/figures/*
!reports/figures/.gitkeep

# Video
*.mp4
*.avi
*.mov

# Python
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# Ortam ve IDE
.env
.venv/
.vscode/
.idea/
.DS_Store
